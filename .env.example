# Use: npm run start:all (Node 24 + Python 3.13 + installed Chrome)
HOST=127.0.0.1
PORT=3001
ACTISCAPE_DATA_DIR=./data
AGENT_PORT=3002
ACTISCAPE_AGENT_URL=http://127.0.0.1:3002
ACTISCAPE_SCENE_URL=http://127.0.0.1:3001
# Server-only credential; leave empty until configured on the host.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=high
# Optional overrides:
# ACTISCAPE_AGENT_DATA_DIR=./data/agent
# CHROME_PATH=/absolute/path/to/chrome
# ACTISCAPE_CODE_VERSION=deployed-git-commit
# ACTISCAPE_TOOL_TOKEN=gateway-managed-server-token

# Optional independent virtual environment for bounded image processing:
# ACTISCAPE_IMAGE_PYTHON=/absolute/path/to/venv/bin/python
