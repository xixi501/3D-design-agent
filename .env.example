# Use: npm run start:all (Node 24 + Python 3.13 + installed Chrome)
HOST=127.0.0.1
PORT=3131
ACTISCAPE_DATA_DIR=./data
AGENT_PORT=3132
ACTISCAPE_AGENT_URL=http://127.0.0.1:3132
ACTISCAPE_SCENE_URL=http://127.0.0.1:3131
# Server-only credential; leave empty until configured on the host.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
ACTISCAPE_VISION_PROVIDER=local-vllm
ACTISCAPE_VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct-FP8
ACTISCAPE_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ACTISCAPE_VISION_API_KEY=local
# ACTISCAPE_VISION_PORT=3133
# ACTISCAPE_VISION_GPU_MEMORY=0.9
# ACTISCAPE_VISION_CACHE=/workspace/.actiscape-tools/models
DEEPSEEK_REASONING_EFFORT=high
# Optional overrides:
# ACTISCAPE_AGENT_DATA_DIR=./data/agent
# CHROME_PATH=/absolute/path/to/chrome
# ACTISCAPE_CODE_VERSION=deployed-git-commit
# ACTISCAPE_TOOL_TOKEN=gateway-managed-server-token

# Optional independent virtual environment for bounded image processing:
# ACTISCAPE_IMAGE_PYTHON=/absolute/path/to/venv/bin/python
