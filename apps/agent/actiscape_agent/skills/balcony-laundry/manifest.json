{
  "schemaVersion": "actiscape.skill.v1",
  "id": "balcony-laundry",
  "name": "生活阳台与家政",
  "version": "0.2.0",
  "kind": "layout",
  "status": "conformant",
  "activation": "reserved",
  "summary": "1.2–6㎡ 生活阳台：先定排水再定机器，决定叠放或并排，留洗衣机前操作面、定晾衣杆高度与长度、处理地漏，并与通客厅的推拉门/窗帘避让。",
  "appliesTo": {
    "modes": ["generate_rectangular"],
    "roomKinds": ["balcony"],
    "areaM2": [1.2, 6],
    "projectState": "empty",
    "requiredInputs": [
      "含墙体、窗与推拉门的阳台场景或实测尺寸",
      "排水地漏与立管位置",
      "洗衣机/烘干机型号（可选）"
    ]
  },
  "notApplicable": [
    "需要改排水立管、楼板开洞或加装地漏",
    "封阳台、改窗、结构加固",
