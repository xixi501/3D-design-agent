{
  "schemaVersion": "actiscape.skill.v1",
  "id": "entry-storage",
  "name": "玄关/过道与入户收纳",
  "version": "0.3.0",
  "kind": "layout",
  "status": "verified",
  "activation": "active",
  "summary": "1.5–20㎡ 玄关或过道：按「开门→落尘→换鞋→挂衣→镜」排动线，按人数估鞋柜容量，控换鞋凳前净空与门扇开启区；过道只保留不挡通行的一侧浅柜或端景。",
  "appliesTo": {
    "modes": [
      "generate_rectangular"
    ],
    "roomKinds": [
      "entry"
    ],
    "areaM2": [
      1.5,
      20
    ],
    "projectState": "empty",
    "requiredInputs": [
