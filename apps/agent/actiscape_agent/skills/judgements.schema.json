{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActiScape Judgement Library v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "items"],
  "properties": {
    "schemaVersion": {
      "const": "actiscape.judgements.v1"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "source": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "threshold", "source", "checkability"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^J-[A-Z]{2,6}-\\d{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "threshold": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "checkability": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
