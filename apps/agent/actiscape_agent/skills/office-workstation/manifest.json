{
  "schemaVersion": "actiscape.skill.v1",
  "id": "office-workstation",
  "name": "小型办公工位与会议室",
  "version": "0.2.0",
  "kind": "layout",
  "status": "conformant",
  "activation": "reserved",
  "summary": "30–60㎡ 工作室：分四块后按 1200×600/1400×700 排工位，留 900 主通道，玻璃隔断围会议区，贴边放打印机，只给插座网口位置建议。",
  "appliesTo": {
    "modes": ["generate_rectangular"],
    "roomKinds": ["office"],
    "areaM2": [30, 60],
