{
  "schemaVersion": "actiscape.skill.v1",
  "id": "pet-friendly",
  "name": "宠物家庭布置",
  "version": "0.2.0",
  "kind": "modifier",
  "status": "conformant",
  "activation": "reserved",
  "summary": "养猫养狗的起居空间：先划宠物活动区与清洁点，猫爬架靠窗但不进窗帘带，猫砂盆/狗窝避开餐厨与主动线，耐抓耐污材料 + 门挡 + 线槽。",
  "appliesTo": {
    "modes": ["generate_rectangular", "edit"],
    "roomKinds": ["any"],
    "areaM2": [12, 35],
    "projectState": "any",
    "requiredInputs": [
      "含墙体与门窗的场景或户型图",
      "宠物种类与数量",
      "猫砂盆/狗窝现状位置（可选）"
    ]
  },
  "notApplicable": [
    "需要拆改或新增独立宠物房",
    "需要全屋新风/除味/排水改造",
    "无宠物的普通客餐厅（转 living-dining-small）"
  ],
  "capabilities": ["scene.read", "candidate.review"],
  "judgements": [
    "J-CIR-01",
    "J-CIR-02",
    "J-COL-02",
    "J-CUR-01",
    "J-VER-01",
    "J-VER-02"
  ],
  "composition": {
    "maxPerTask": 1,
    "conflictsWith": []
  },
  "license": {
    "spdx": "MIT",
    "attribution": "repository:ATTRIBUTIONS.md"
  },
  "validation": {
    "structure": true,
    "dryRun": true,
    "realCore": false
  }
}
