{
  "schemaVersion": "actiscape.skill.v1",
  "id": "photo-object-import",
  "name": "照片物品入场景与局部摆放",
  "version": "0.2.0",
  "kind": "asset",
  "status": "conformant",
  "activation": "reserved",
  "summary": "单件照片 → 异步资产作业 → 外观与尺寸确认 → 落到点选或语言指定的支撑面 → 检查与留证。",
  "appliesTo": {
    "modes": ["asset_import"],
    "roomKinds": ["any"],
    "areaM2": [0, 1000],
    "projectState": "existing",
    "requiredInputs": [
      "单件物品照片",
      "尺寸线索（可缺，缺则必须问）",
      "落点或目标对象"
    ]
  },
  "notApplicable": [
    "多件物品合影",
    "透明/强反光/极细长物品",
    "需要精确测绘还原",
    "场景尚不存在"
  ],
  "capabilities": [
    "scene.read",
    "asset.job",
    "candidate.propose",
    "candidate.preflight",
    "candidate.review",
    "candidate.render"
  ],
  "judgements": [
    "J-ASSET-01",
    "J-ASSET-02",
    "J-CIR-01",
    "J-OVER-01",
    "J-VER-01",
    "J-VER-02"
  ],
  "composition": {
    "maxPerTask": 1,
    "conflictsWith": []
  },
  "license": {
    "spdx": "MIT",
    "attribution": "repository:ATTRIBUTIONS.md"
  },
  "validation": {
    "structure": true,
    "dryRun": true,
    "realCore": false
  }
}
