  "components": {
    "schemas": {
      "ConversationInput": {
        "properties": {
          "projectId": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Projectid"
          }
        },
        "type": "object",
        "required": ["projectId"],
        "title": "ConversationInput"
      },
      "FloorplanConfirmInput": {
        "properties": {
          "requestId": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Requestid"
          },
          "draftId": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Draftid"
          },
          "draftRevision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Draftrevision"
          },
          "draftHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Drafthash"
          }
        },
        "type": "object",
        "required": ["requestId", "draftId", "draftRevision", "draftHash"],
        "title": "FloorplanConfirmInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ResumeInput": {
        "properties": {
          "requestId": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Requestid"
          },
          "input": {
            "type": "string",
            "maxLength": 4000,
            "title": "Input",
            "default": ""
          },
          "selectedIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Selectedids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["requestId"],
        "title": "ResumeInput"
      },
      "TaskInput": {
        "properties": {
          "requestId": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Requestid"
          },
          "input": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Input"
          },
          "selectedIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Selectedids"
          },
          "mode": {
            "type": "string",
            "enum": ["edit", "generate_rectangular", "reconstruct_floorplan"],
            "title": "Mode",
            "default": "edit"
          },
          "imageId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Imageid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["requestId", "input"],
        "title": "TaskInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    }
  }
