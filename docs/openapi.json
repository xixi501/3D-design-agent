    "/api/projects/{id}/initialization-preview": {
      "post": {
        "description": "Read-only rectangular structure preview for an empty project; fixed task ID gives stable structure IDs",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["taskId", "baseRevision", "brief"],
                "additionalProperties": false,
                "properties": {
                  "taskId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "baseRevision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "brief": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/projects/{id}/candidates": {
      "get": {
        "description": "List immutable local-edit candidates without changing the project",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "post": {
        "description": "Create a candidate from scoped furniture edits. requestId deduplicates creation and allocated object IDs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["requestId", "taskId", "baseRevision"],
                "properties": {
                  "requestId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "taskId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "baseRevision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "summary": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "kind": {
                    "type": "string",
                    "enum": ["edit", "initialize", "initialize_floorplan"]
                  },
                  "floorplan": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["draftId", "draftRevision", "draftHash"],
                    "properties": {
                      "draftId": {
                        "type": "string"
                      },
                      "draftRevision": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "draftHash": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  },
                  "matches": {
                    "type": "array",
                    "maxItems": 50,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["symbolId", "key"],
                      "properties": {
                        "symbolId": {
                          "type": "string"
                        },
                        "key": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "brief": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "scope": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "edits": {
                    "type": "array",
                    "minItems": 0,
                    "maxItems": 50,
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
