    "/api/projects/{id}/commands": {
      "post": {
        "description": "Atomically apply structured commands. 409 on stale revision or operation ID reuse with different content. Identical retries return the original result.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["operationId", "baseRevision"],
                "properties": {
                  "operationId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "baseRevision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "summary": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "commands": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
