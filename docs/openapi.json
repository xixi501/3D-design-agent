    "/api/projects/{id}/candidates": {
      "get": {
        "description": "List immutable local-edit candidates without changing the project",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "post": {
        "description": "Create a candidate from scoped furniture edits. requestId deduplicates creation and allocated object IDs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "requestId",
                  "taskId",
                  "baseRevision",
                  "scope",
                  "edits"
                ],
                "properties": {
                  "requestId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "taskId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "baseRevision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "summary": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "scope": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "edits": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 50,
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
