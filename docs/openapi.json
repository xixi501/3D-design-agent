    "/api/projects/{id}/candidates/{candidate}/review": {
      "post": {
        "description": "Record independent agent or explicit operator review referencing both evidence hashes",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "passed",
                  "source",
                  "summary",
                  "objectIds",
                  "evidenceHashes",
                  "issues"
                ],
                "additionalProperties": false,
                "properties": {
                  "passed": {
                    "type": "boolean"
                  },
                  "source": {
                    "type": "string",
                    "enum": ["agent", "operator"]
                  },
                  "summary": {
                    "type": "string",
                    "maxLength": 4000
                  },
                  "objectIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "evidenceHashes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "issues": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "candidate",
            "required": true
          }
