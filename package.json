{
  "name": "actiscape",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/run-all.mjs --dev",
    "start": "node --env-file-if-exists=.env --import tsx apps/service/src/main.ts",
    "build": "npm run typecheck && vite build --config apps/editor/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:baseline": "node scripts/baseline.mjs",
    "test:browser": "node scripts/browser-acceptance.mjs",
    "test:reference": "node scripts/verify-reference.mjs",
    "test:baseline:extended": "node scripts/baseline-extended.mjs",
    "test:parity": "node --import tsx scripts/modeling-parity.mjs",
    "test:all": "npm run test:reference && npm test && npm run build && npm run reference:build && npm run test:baseline && npm run test:baseline:extended && npm run test:browser && npm run test:parity && npm run test:catalog && npm run test:visual",
    "fixtures:gallery": "tsx scripts/prepare-gallery.ts",
    "tools:demo": "node scripts/tool-demo.mjs",
    "reference:build": "node scripts/prepare-reference.mjs",
    "test:catalog": "node scripts/compare-catalog.mjs",
    "test:visual": "node --import tsx scripts/visual-baseline.mjs",
    "dev:editor": "node scripts/dev.mjs",
    "start:all": "node --env-file-if-exists=.env scripts/run-all.mjs",
    "start:agent": ".venv/bin/python -m actiscape_agent",
    "setup:agent": "node scripts/setup-agent.mjs",
    "setup:vision": "node scripts/setup-vision.mjs",
    "download:vision": "node scripts/setup-vision.mjs --download",
    "start:vision": "node scripts/start-vision-model.mjs",
    "test:agent": ".venv/bin/python -m pytest -q apps/agent/tests",
    "test:candidates": "node --import tsx scripts/candidate-acceptance.mjs",
    "test:agent:smoke": ".venv/bin/python -m actiscape_agent.smoke",
    "test:agent:live": "node scripts/agent-acceptance.mjs",
    "test:agent:browser": "node scripts/agent-browser-acceptance.mjs",
    "tools:agent-demo": "node scripts/agent-demo.mjs",
    "test:initialization": "node --import tsx scripts/initialization-acceptance.mjs",
    "tools:generation-demo": "node scripts/generation-demo.mjs",
    "test:generation:live": "node scripts/generation-acceptance.mjs",
    "test:generation:browser": "node scripts/generation-browser-acceptance.mjs",
    "test:floorplan": "node --import tsx scripts/floorplan-acceptance.mjs",
    "test:floorplan:v3": "node --import tsx scripts/floorplan-acceptance.mjs --v3",
    "test:floorplan:v35-replay": "node --import tsx scripts/floorplan-v35-replay.mjs",
    "test:floorplan:v36-replay": "node --import tsx scripts/floorplan-v36-replay.mjs",
    "test:floorplan:live": "node --import tsx scripts/floorplan-live.mjs",
    "test:floorplan:tools:live": "node --import tsx scripts/floorplan-tools-live.mjs",
    "pretest": "node scripts/image-runtime.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.7",
    "@fastify/static": "10.1.10",
    "@fastify/swagger": "9.9.3",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.8",
    "puppeteer-core": "25.16.0",
    "three": "0.160.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@babel/generator": "8.1.0",
    "@babel/parser": "8.1.0",
    "@babel/traverse": "8.1.0",
    "@babel/types": "8.1.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/three": "0.160.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
