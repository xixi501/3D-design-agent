      {"name": "scene.apply_edits", "min_version": "0.1"},
      {"name": "check.run", "min_version": "0.1"}
    ],
    "judgements": ["J-BAL-01", "J-CIR-01", "J-DOOR-01", "J-CUR-01", "J-VER-01", "J-VER-02"],
    "assets": []
  },
  "cases": [
    {"id": "BAL-dev-01", "kind": "positive", "expect": "check.run 全通过：推拉门前 400 无家具、窗内侧 150 无高家具、无重叠"},
    {"id": "BAL-dev-02", "kind": "boundary", "expect": "check.run 报 DOOR-01（洗衣机堵住推拉门）"}
  ],
