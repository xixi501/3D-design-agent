  "name": "生活阳台与家政",
  "version": "0.1.0",
  "status": "pending_adaptation",
  "level": "structure",
  "summary": "1.2–6㎡ 生活阳台：先定排水再定机器，决定叠放或并排，留洗衣机前操作面、定晾衣杆高度与长度、处理地漏，并与通客厅的推拉门/窗帘避让。",
  "applies_when": {
    "scene_types": ["生活阳台", "家政阳台", "洗衣房", "阳台"],
    "area_m2": [1.2, 6],
    "inputs": ["含墙体、窗与推拉门的阳台场景或实测尺寸", "排水地漏与立管位置", "洗衣机/烘干机型号（可选）"],
    "preconditions": ["场景已有墙体与门窗", "排水与地漏位置已知", "阳台净高已知（叠放要看）"]
  },
  "not_applicable": ["需要改排水立管、楼板开洞或加装地漏", "封阳台、改窗、结构加固", "纯景观阳台（不洗衣）", "需要增加阳台热水点位", "需要做阳光房"],
  "depends": {
    "tools": [
      {"name": "catalog.search", "min_version": "0.1"},
