{
  "schema_version": "0.1",
  "id": "layout-check-repair",
  "name": "检查与有限修复",
  "version": "0.1.0",
  "status": "pending_adaptation",
  "level": "structure",
  "summary": "对已有布置跑 check.run，按严重度与影响对象数排序，一次只修一类，每轮重跑，3 轮预算用完即停，修不动的写进未解决清单并如实报告。",
  "applies_when": {
    "scene_types": ["全屋", "起居室", "客餐厅", "卧室", "书房", "小型办公"],
    "area_m2": [5, 200],
    "inputs": ["已有布置的场景", "用户指定要保留的对象（可选）", "修复预算轮次（可选，默认 3）"],
    "preconditions": ["场景已有至少一版布置", "check.run 可用或可人工替代"]
  },
  "not_applicable": ["从零布置", "需要拆改墙体或门窗洞口", "要求改到通过为止（预算制不适用）", "需要验收规则本身的变更"],
  "depends": {
    "tools": [
      {"name": "check.run", "min_version": "0.1"},
      {"name": "scene.get_snapshot", "min_version": "0.1"},
      {"name": "scene.apply_edits", "min_version": "0.1"},
      {"name": "scene.diff", "min_version": "0.1"},
      {"name": "view.capture", "min_version": "0.1"}
    ],
    "judgements": ["J-CIR-01", "J-CIR-02", "J-CUR-01", "J-DOOR-01", "J-DOOR-02", "J-OVER-01", "J-VER-01", "J-VER-02", "J-WIN-01"],
    "assets": []
  },
  "cases": [
    {"id": "LCR-dev-01", "kind": "positive", "expect": "修复后 check.run 全通过"},
    {"id": "LCR-dev-02", "kind": "boundary", "expect": "3 轮用尽仍报 WIN-01，如实报告未解决"}
  ],
  "provenance": {
    "based_on": ["house-plan-designer@b94183f9/reference/workflow-check.md", "ICT 项目设计书 §4.4（内层修复）"],
    "license": "MIT",
    "external_refs": ["interior-design-expert (clearance data)"]
  },
  "validation": {"record": null, "checked_at": null, "checks": []}
}
