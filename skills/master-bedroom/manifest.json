{
  "schema_version": "0.1",
  "id": "master-bedroom",
  "name": "主卧：睡眠区、收纳与梳妆取舍",
  "version": "0.1.0",
  "status": "pending_adaptation",
  "level": "structure",
  "summary": "10–20㎡ 主卧：先定床头墙与床侧通道，再按“柜前净空优先”定衣柜，最后在衣柜/梳妆/电视之间做明确取舍，并处理窗帘与窗下净空。",
  "applies_when": {
    "scene_types": ["主卧", "卧室"],
    "area_m2": [10, 20],
    "inputs": ["含墙体与门窗的场景或户型图", "床的规格（1.5/1.8）", "衣柜门型（平开/推拉）", "梳妆与电视的意愿（可选）"],
    "preconditions": ["场景已有墙体与门窗", "房间名可用于面积下限匹配", "用户已确定床的尺寸或允许按 1.5 保守取值"]
  },
  "not_applicable": [
    "儿童房、老人房、保姆间（转 kids-room / aging-friendly）",
    "主卧带独立衣帽间或卫浴套间（先定内隔再回到本技能）",
    "需要改门洞、加窗或动水电点位",
    "使用面积 < 10㎡ 的次卧（转 studio-micro 或按单人卧室下限处理）"
  ],
  "depends": {
    "tools": [
      {"name": "catalog.search", "min_version": "0.1"},
      {"name": "scene.get_snapshot", "min_version": "0.1"},
      {"name": "scene.apply_edits", "min_version": "0.1"},
      {"name": "check.run", "min_version": "0.1"},
      {"name": "view.capture", "min_version": "0.1"}
    ],
    "judgements": [
      "J-CIR-04", "J-CIR-06", "J-CIR-08", "J-CUR-01", "J-PROP-01", "J-STA-01",
      "J-LIGHT-02", "J-DOOR-02", "J-OVER-01", "J-ASSET-02", "J-VER-01", "J-VER-02"
    ],
    "assets": []
  },
  "cases": [
    {"id": "MBR-dev-01", "kind": "positive", "expect": "check.run 全通过：门扇区让开衣柜、窗内侧带无高柜、台灯压在柜面内"},
    {"id": "MBR-dev-02", "kind": "boundary", "expect": "check.run 报 DOOR-02：衣柜压进门扇扫掠区"}
  ],
