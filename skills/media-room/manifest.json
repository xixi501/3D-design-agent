{
  "schema_version": "0.1",
  "id": "media-room",
  "name": "影音 / 娱乐室",
  "version": "0.1.0",
  "status": "pending_adaptation",
  "level": "structure",
  "summary": "10–25㎡ 影音室：按屏幕对角线 × 1.2–1.6 定观看距离，排沙发侧向通道、音箱位、遮光与设备柜散热。",
  "applies_when": {
    "scene_types": [
      "影音室",
      "家庭影院",
      "娱乐室",
      "游戏室"
    ],
    "area_m2": [
      10,
      25
    ],
    "inputs": [
      "含墙体与门窗的场景或户型图",
      "常坐人数（可选）",
      "屏幕规格（可选）",
      "设备清单：投影/功放/低音炮（可选）"
    ],
    "preconditions": [
      "场景已有墙体与门窗",
      "屏幕墙为无洞口的实墙",
      "房间净深可信（缺失时先补）"
    ]
  },
  "not_applicable": [
    "客厅兼影院（转 living-dining-small / living-dining-open）",
    "需要声学装修（吸音/隔声/浮筑地板）",
    "需要投影吊装与强弱电布线",
    "需要拆改墙体或门窗洞口"
  ],
