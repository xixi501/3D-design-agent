  "id": "pet-friendly",
  "name": "宠物家庭布置",
  "version": "0.1.0",
  "status": "pending_adaptation",
  "level": "structure",
  "summary": "养猫养狗的起居空间：先划宠物活动区与清洁点，猫爬架靠窗但不进窗帘带，猫砂盆/狗窝避开餐厨与主动线，耐抓耐污材料 + 门挡 + 线槽。",
  "applies_when": {
    "scene_types": ["起居室", "客厅", "客餐厅"],
    "area_m2": [12, 35],
    "inputs": ["含墙体与门窗的场景或户型图", "宠物种类与数量", "猫砂盆/狗窝现状位置（可选）"],
    "preconditions": ["场景已有墙体与门窗", "已知是否封窗/是否有宠物门栏"]
  },
  "not_applicable": ["需要拆改或新增独立宠物房", "需要全屋新风/除味/排水改造", "无宠物的普通客餐厅（转 living-dining-small）"],
  "depends": {
    "tools": [
      {"name": "catalog.search", "min_version": "0.1"},
      {"name": "scene.get_snapshot", "min_version": "0.1"},
      {"name": "scene.apply_edits", "min_version": "0.1"},
      {"name": "check.run", "min_version": "0.1"}
    ],
    "judgements": ["J-CIR-01", "J-CIR-02", "J-COL-02", "J-CUR-01", "J-VER-01", "J-VER-02"],
    "assets": []
  },
  "cases": [
    {"id": "PET-dev-01", "kind": "positive", "expect": "check.run 全通过：700 通道、猫爬架退出窗帘带、无重叠"},
    {"id": "PET-dev-02", "kind": "boundary", "expect": "check.run 报 CUR-01（猫爬架在窗内侧 150 内且 h>600）"}
  ],
  "provenance": {
