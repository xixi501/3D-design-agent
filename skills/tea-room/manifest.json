      {"name": "scene.apply_edits", "min_version": "0.1"},
      {"name": "check.run", "min_version": "0.1"}
    ],
    "judgements": ["J-CIR-01", "J-CIR-02", "J-CIR-07", "J-LIGHT-01", "J-LIGHT-02", "J-COL-01", "J-OVER-01", "J-STY-03", "J-VER-01", "J-VER-02"],
    "assets": []
  },
  "cases": [
    {"id": "TEA-dev-01", "kind": "positive", "expect": "check.run 全通过：西侧贯通 700 通道、茶台与座位间距达标、门口可落脚"},
