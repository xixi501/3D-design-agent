  "status": "pending_adaptation",
  "level": "structure",
  "summary": "4–10㎡ 茶室：远离主动线、坐席不对门不背窗，用一桌两椅一柜的最小配置守住 700 通行与茶台间距。",
  "applies_when": {
    "scene_types": ["茶室", "静区", "冥想角", "书房兼茶室"],
    "area_m2": [4, 10],
    "inputs": ["含墙体与门窗的场景或户型图", "一人用还是两人对坐（可选）", "主视线方向（可选）", "是否需要烧水（可选）"],
    "preconditions": ["场景已有墙体与门窗", "门的开启方向与窗的位置可信（缺失时先问）"]
  },
  "not_applicable": ["需待客六人以上（转 social-reading-zone）", "要做地台/榻榻米（先走 tatami-multipurpose）", "需要给排水、地暖、防水改造", "需要拆改墙体或门窗洞口"],
  "depends": {
    "tools": [
      {"name": "catalog.search", "min_version": "0.1"},
